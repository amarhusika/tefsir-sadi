<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Odaberi / Ukucaj -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toggle"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/btnModeSelect"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Odaberi"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnModeType"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Ukucaj"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Padajući izbornici -->
    <LinearLayout
        android:id="@+id/boxSelects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.08"
            android:text="SURA"
            android:textColor="@color/ink_4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spSura"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_spinner"
            android:popupBackground="@drawable/bg_card_flat"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.08"
            android:text="AJET"
            android:textColor="@color/ink_4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spAyah"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_spinner"
            android:popupBackground="@drawable/bg_card_flat"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <!-- Unos Sura:Ajet -->
    <LinearLayout
        android:id="@+id/boxType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etRef"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:digits="0123456789:"
                android:hint="npr. 2:255"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="7"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_4"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnColon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_input"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text=":"
                android:textColor="@color/sienna"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sura:Ajet"
            android:textColor="@color/ink_4"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnGo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_primary"
        android:drawableEnd="@drawable/ic_arrow_right"
        android:drawablePadding="8dp"
        android:drawableTint="@color/white"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="Otvori"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</merge>
